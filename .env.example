PORT=3000
# Copy the Session pooler URI from Supabase Dashboard > Connect; URL-encode reserved password characters.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<encoded-db-password>@<session-pooler-host>:5432/postgres?sslmode=require
DB_POOL_MAX=10
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
ADMIN_SETUP_TOKEN=replace-with-a-long-random-one-time-token
COOKIE_SECURE=false
# Optional SQLite source path for the one-time import (defaults to data/travlish.sqlite).
# SQLITE_DATABASE_PATH=
# Optional: enable Google sign-in after implementing your authorized OAuth callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
